# SQLite en local. En production, passer provider = "postgresql" dans prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Secret pour signer les cookies de session (32+ caractères aléatoires)
SESSION_SECRET="change-moi-avec-une-longue-chaine-aleatoire"
# URL publique de l'app (utilisée dans les liens WhatsApp envoyés aux clients)
APP_URL="http://localhost:3000"
# Clé API Anthropic pour l'import photo des carnets papier (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
